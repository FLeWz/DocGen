# Copy to .env (make up does it for you) and change every secret.
COMPOSE_PROJECT_NAME=docgen
WEB_PORT=8080
MAIL_UI_PORT=8025
PUBLIC_URL=http://localhost:8080
POSTGRES_USER=docgen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docgen
# password of the non-superuser role the API uses at runtime (RLS applies to it)
APP_DB_PASSWORD=change-me-too
SECRET_KEY=change-me-long-random
COOKIE_SECURE=false
# 1 = create demo org/users/data on api start (idempotent, dev only: users have documented passwords). 0 = off.
SEED_DEMO=1
# 0 = invite-only (default). 1 = anyone can POST /api/auth/signup and create an org. Bootstrap: python -m app.manage create-user
ALLOW_SIGNUP=0
# --- Outgoing mail (invites, test email). Default = Mailpit in this compose stack (no auth, no TLS).
# Empty values mean "unset": defaults and presets are resolved in backend/app/mail.py. Details: README, "Mail (SMTP)".
SMTP_PRESET=
SMTP_HOST=
SMTP_PORT=
# none | starttls | ssl   (default none; Microsoft 365 = starttls on 587)
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
# alternative to SMTP_PASSWORD: path of a file inside the api container (Docker/Kubernetes secret)
SMTP_PASSWORD_FILE=
# auto | login | plain | xoauth2 | none   (default auto)
SMTP_AUTH=
# Sender address. Microsoft 365: the mailbox itself or an alias with Send As rights.
SMTP_FROM=DocGen <noreply@docgen.local>
SMTP_FROM_NAME=
SMTP_REPLY_TO=
SMTP_TIMEOUT=
SMTP_VERIFY_TLS=
SMTP_CA_BUNDLE=
SMTP_EHLO_HOSTNAME=
# SMTP_AUTH=xoauth2 (Exchange Online, client credentials), see README
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
# Example, Microsoft 365 with an app password:
#   SMTP_PRESET=microsoft365  SMTP_USERNAME=docgen@your-tenant.example  SMTP_PASSWORD=...  SMTP_FROM=docgen@your-tenant.example
