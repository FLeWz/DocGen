# Copy to .env (make up does it for you) and change every secret.
COMPOSE_PROJECT_NAME=docgen
WEB_PORT=8080
MAIL_UI_PORT=8025
PUBLIC_URL=http://localhost:8080
POSTGRES_USER=docgen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docgen
# password of the non-superuser role the API uses at runtime (RLS applies to it)
APP_DB_PASSWORD=change-me-too
SECRET_KEY=change-me-long-random
COOKIE_SECURE=false
# 1 = create demo org/users/data on api start (idempotent, dev only: users have documented passwords). 0 = off.
SEED_DEMO=1
# 0 = invite-only (default). 1 = anyone can POST /api/auth/signup and create an org. Bootstrap: python -m app.manage create-user
ALLOW_SIGNUP=0
# --- Outgoing mail (invites, test email). Default = Mailpit in this compose stack (no auth, no TLS).
# Empty values mean "unset": defaults and presets are resolved in backend/app/mail.py. Details: README, "Mail (SMTP)".
SMTP_PRESET=
SMTP_HOST=
SMTP_PORT=
# none | starttls | ssl   (default none; Microsoft 365 = starttls on 587)
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
# alternative to SMTP_PASSWORD: path of a file inside the api container (Docker/Kubernetes secret)
SMTP_PASSWORD_FILE=
# auto | login | plain | xoauth2 | none   (default auto)
SMTP_AUTH=
# Sender address. Microsoft 365: the mailbox itself or an alias with Send As rights.
SMTP_FROM=DocGen <noreply@docgen.local>
SMTP_FROM_NAME=
SMTP_REPLY_TO=
SMTP_TIMEOUT=
SMTP_VERIFY_TLS=
SMTP_CA_BUNDLE=
SMTP_EHLO_HOSTNAME=
# SMTP_AUTH=xoauth2 (Exchange Online, client credentials), see README
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
# Example, Microsoft 365 with an app password:
#   SMTP_PRESET=microsoft365  SMTP_USERNAME=docgen@your-tenant.example  SMTP_PASSWORD=...  SMTP_FROM=docgen@your-tenant.example

# --- Authentication: local (default) | oidc. With oidc the password login, sign-up and password invite-accept are off.
AUTH_MODE=local
# The OIDC_* values below only matter when AUTH_MODE=oidc. Full table and examples: docs/OIDC.md
# Issuer URL; discovery is read from <issuer>/.well-known/openid-configuration. Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
# empty = public client (PKCE only)
OIDC_CLIENT_SECRET=
# Button label: "Sign in with <name>"
OIDC_PROVIDER_NAME=
# Register this at the IdP: <PUBLIC_URL>/api/auth/oidc/callback (override only if a proxy changes the external URL)
OIDC_REDIRECT_URI=
OIDC_SCOPES=
OIDC_EMAIL_CLAIM=
OIDC_NAME_CLAIM=
OIDC_USERNAME_CLAIM=
# optional role mapping, e.g. OIDC_GROUPS_CLAIM=groups  OIDC_ROLE_MAP=docgen-admins=admin,docgen-editors=editor
OIDC_GROUPS_CLAIM=
OIDC_ROLE_MAP=
# comma list, e.g. example.com,example.org
OIDC_ALLOWED_EMAIL_DOMAINS=
# private company CA: put the PEM in ./certs/ and set OIDC_CA_BUNDLE=/certs/company-ca.pem (never turn verification off in production)
OIDC_VERIFY_TLS=
OIDC_CA_BUNDLE=
# log out at the IdP too (default 1); Keycloak: register <PUBLIC_URL>/login under Valid post logout redirect URIs
OIDC_END_SESSION=
# 1 = always send prompt=login (otherwise only right after a logout)
OIDC_FORCE_REAUTH=
# accounts are always auto-created at first login (OIDC_AUTO_PROVISION is gone); the role comes from the token:
# client roles owner/admin/editor/viewer at resource_access.<client>.roles; no role = login refused
# client whose roles are read (default OIDC_CLIENT_ID), also read realm roles (1), role name prefix (e.g. docgen-)
OIDC_ROLES_CLIENT_ID=
OIDC_REALM_ROLES=
OIDC_ROLE_PREFIX=
OIDC_LINK_BY_EMAIL=
OIDC_DEFAULT_ORG=
# optional fallback role for users without any role in the token (empty = refuse)
OIDC_DEFAULT_ROLE=
