# Copy to .env (make up does it for you) and change every secret.
COMPOSE_PROJECT_NAME=docgen
WEB_PORT=8080
MAIL_UI_PORT=8025
PUBLIC_URL=http://localhost:8080
POSTGRES_USER=docgen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docgen
# password of the non-superuser role the API uses at runtime (RLS applies to it)
APP_DB_PASSWORD=change-me-too
SECRET_KEY=change-me-long-random
COOKIE_SECURE=false
# 1 = create demo org/users/data on api start (idempotent, dev only: users have documented passwords). 0 = off.
SEED_DEMO=1
# 0 = invite-only (default). 1 = anyone can POST /api/auth/signup and create an org. Bootstrap: python -m app.manage create-user
ALLOW_SIGNUP=0
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=DocGen <noreply@docgen.local>
